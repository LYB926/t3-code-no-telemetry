# Maintainer: Zhang Ke
# Thin Arch / CachyOS PKGBUILD wrapper invoking ../../t3clean.py.
# For standalone AUR uploads (flat directory with zero ../../ paths), run:
#   python3 t3clean.py export-aur --out <dir>

pkgname=t3-code-no-telemetry
pkgver=0.1.12
pkgrel=1
pkgdesc='T3 Code desktop application built from source with telemetry, device tracking, and cloud auth stripped'
arch=('x86_64' 'aarch64')
url='https://github.com/pingdotgg/t3code'
license=('MIT')
options=('!strip' '!debug')

# Pinned stable upstream ref by default; override with e.g. T3CODE_REF=main
_upstream_ref="${T3CODE_REF:-v0.1.12}"

# Optional build switches (all disabled by default)
_build_deb="${T3CLEAN_BUILD_DEB:-0}"
_use_system_electron="${T3CLEAN_USE_SYSTEM_ELECTRON:-0}"
_system_electron_bin="${T3CLEAN_SYSTEM_ELECTRON_BIN:-electron}"
_keep_updater="${T3CLEAN_KEEP_UPDATER:-0}"
_keep_cloud="${T3CLEAN_KEEP_CLOUD:-0}"
_strict_offline="${T3CLEAN_STRICT_OFFLINE:-0}"
_jobs="${T3CLEAN_JOBS:-}"

# Coexists cleanly with t3code-bin (no conflicts/provides overlap).
# Shares user state (~/.t3/userdata/ and ~/.config/t3code-v2/) while using
# independent /usr/lib/t3-code-no-telemetry and /usr/bin/t3-code-no-telemetry.
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'glib2'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdbusmenu-glib'
  'libdrm'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'libxtst'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
)
if [[ "${_use_system_electron}" == "1" ]]; then
  depends+=("${_system_electron_bin}")
fi

# All makedepends are in official Arch/CachyOS repos (zero AUR build deps).
# Vite+ (`vp >= 1.4.0`) is reused from PATH when present, or bootstrapped into
# `${_cache_dir}/toolchains/vp-isolated` via host `npm` (avoids outdated AUR
# `vite-plus-bin` and `rustup`/`rust` package conflicts).
makedepends=(
  'git'
  'python'
  'nodejs>=26.12.1'
  'npm'
  'gcc'
  'make'
  'rust'
  'pkgconf'
  'imagemagick'
)

optdepends=(
  'openai-codex: use the system-installed Codex CLI'
)

# Download lightweight GitHub source archive (~tens of MB) instead of makepkg's
# full `git clone --mirror` (~3.5 GiB across 2.6M objects).
_ref_safe="${_upstream_ref//\//-}"
if [[ "${_upstream_ref}" =~ ^v[0-9] ]]; then
  _source_url="https://github.com/pingdotgg/t3code/archive/refs/tags/${_upstream_ref}.tar.gz"
elif [[ "${_upstream_ref}" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
  _source_url="https://github.com/pingdotgg/t3code/archive/${_upstream_ref}.tar.gz"
else
  _source_url="https://github.com/pingdotgg/t3code/archive/refs/heads/${_upstream_ref}.tar.gz"
fi

source=(
  "t3code-${_ref_safe}.tar.gz::${_source_url}"
  "t3-code-no-telemetry.sh"
  "t3-code-no-telemetry.desktop"
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

_t3clean_repo_root() {
  if [[ -n "${T3CLEAN_REPO_ROOT:-}" ]]; then
    printf '%s' "${T3CLEAN_REPO_ROOT}"
  else
    cd "${startdir}/../.." && pwd
  fi
}

_t3clean_source_dir() {
  local _ref_no_v="${_upstream_ref#v}"
  local _cand
  for _cand in \
    "${srcdir}/t3code-${_ref_no_v}" \
    "${srcdir}/t3code-${_ref_safe}" \
    "${srcdir}/t3code"; do
    if [[ -d "${_cand}" ]]; then
      printf '%s' "${_cand}"
      return 0
    fi
  done
  _cand="$(find "${srcdir}" -maxdepth 1 -mindepth 1 -type d -name 't3code-*' -print -quit)"
  if [[ -n "${_cand}" && -f "${_cand}/package.json" ]]; then
    printf '%s' "${_cand}"
    return 0
  fi
  echo "ERROR: Extracted T3 Code source directory not found under ${srcdir}" >&2
  return 1
}

_t3clean_arch() {
  case "${CARCH}" in
    x86_64)  printf 'x64' ;;
    aarch64) printf 'arm64' ;;
    *)       printf 'x64' ;;
  esac
}

_t3clean_semver() {
  if [[ "${pkgver}" =~ ^([0-9]+\.[0-9]+\.[0-9]+)\.(.+)$ ]]; then
    printf '%s-%s+notelemetry' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  else
    printf '%s+notelemetry' "${pkgver}"
  fi
}

# AUR-compliant caching: defaults to $srcdir/.cache (clean-chroot safe).
# Set T3CLEAN_CACHE_DIR (e.g. ~/.cache/t3-code-no-telemetry) to persist
# isolated vp, ELECTRON_CACHE, ELECTRON_BUILDER_CACHE, CARGO_HOME, PNPM_HOME,
# and npm_config_store_dir across rebuilds.
_t3clean_cache_dir() {
  if [[ -n "${T3CLEAN_CACHE_DIR:-}" ]]; then
    printf '%s' "${T3CLEAN_CACHE_DIR}"
  else
    printf '%s' "${srcdir}/.cache"
  fi
}

pkgver() {
  if [[ "${_upstream_ref}" =~ ^v?([0-9]+\.[0-9]+\.[0-9]+.*)$ ]]; then
    printf '%s' "${BASH_REMATCH[1]//-/.}"
    return
  fi
  local _src_dir _base
  _src_dir="$(_t3clean_source_dir)"
  _base="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["version"])' "${_src_dir}/apps/server/package.json" 2>/dev/null || printf '%s' "${pkgver}")"
  printf '%s.%s' "${_base//-/.}" "${_upstream_ref//[^A-Za-z0-9._]/.}"
}

prepare() {
  local _repo_root _src_dir
  _repo_root="$(_t3clean_repo_root)"
  _src_dir="$(_t3clean_source_dir)"
  local _patch_args=(--source "${_src_dir}")
  if [[ "${_keep_updater}" == "1" ]]; then
    _patch_args+=(--keep-updater)
  fi
  if [[ "${_keep_cloud}" == "1" ]]; then
    _patch_args+=(--keep-cloud)
  fi
  python3 "${_repo_root}/t3clean.py" patch "${_patch_args[@]}"
}

build() {
  local _repo_root _src_dir _arch _build_ver _cache_dir
  _repo_root="$(_t3clean_repo_root)"
  _src_dir="$(_t3clean_source_dir)"
  _arch="$(_t3clean_arch)"
  _build_ver="$(_t3clean_semver)"
  _cache_dir="$(_t3clean_cache_dir)"

  mkdir -p "${_cache_dir}/electron" "${_cache_dir}/electron-builder" "${_cache_dir}/cargo" "${_cache_dir}/pnpm" "${_cache_dir}/pnpm-store"
  export ELECTRON_CACHE="${_cache_dir}/electron"
  export ELECTRON_BUILDER_CACHE="${_cache_dir}/electron-builder"
  export CARGO_HOME="${_cache_dir}/cargo"
  export PNPM_HOME="${_cache_dir}/pnpm"
  export npm_config_store_dir="${_cache_dir}/pnpm-store"
  export VP_NODE_MANAGER=no

  local _build_args=(
    --source "${_src_dir}"
    --skip-fetch
    --skip-patch
    --skip-verify
    --bootstrap-toolchain
    --target desktop-dir
    --arch "${_arch}"
    --version "${_build_ver}"
    --output-dir "${srcdir}/out"
    --cache-dir "${_cache_dir}"
  )
  if [[ "${_use_system_electron}" == "1" ]]; then
    _build_args+=(--use-system-electron --system-electron-bin "${_system_electron_bin}")
  fi
  if [[ -n "${_jobs}" ]]; then
    _build_args+=(--jobs "${_jobs}")
  fi
  if [[ "${_keep_updater}" == "1" ]]; then
    _build_args+=(--keep-updater)
  fi
  if [[ "${_keep_cloud}" == "1" ]]; then
    _build_args+=(--keep-cloud)
  fi

  python3 "${_repo_root}/t3clean.py" build "${_build_args[@]}"

  if [[ "${_build_deb}" == "1" ]]; then
    local _deb_out="${T3CLEAN_DEB_OUT_DIR:-${srcdir}/out-deb}"
    local _deb_args=(
      --source "${_src_dir}"
      --skip-fetch
      --skip-patch
      --skip-install
      --skip-verify
      --bootstrap-toolchain
      --target desktop-deb
      --arch "${_arch}"
      --version "${_build_ver}"
      --output-dir "${_deb_out}"
      --cache-dir "${_cache_dir}"
    )
    if [[ -n "${_jobs}" ]]; then
      _deb_args+=(--jobs "${_jobs}")
    fi
    if [[ "${_keep_updater}" == "1" ]]; then
      _deb_args+=(--keep-updater)
    fi
    if [[ "${_keep_cloud}" == "1" ]]; then
      _deb_args+=(--keep-cloud)
    fi
    python3 "${_repo_root}/t3clean.py" build "${_deb_args[@]}"
  fi
}

check() {
  local _repo_root _artifact_dir
  _repo_root="$(_t3clean_repo_root)"
  if [[ "${_use_system_electron}" == "1" ]]; then
    _artifact_dir="${srcdir}/out/linux-system-electron"
  else
    _artifact_dir="$(find "${srcdir}/out" -maxdepth 1 -type d -name 'linux*-unpacked' -print -quit)"
  fi
  if [[ -z "${_artifact_dir}" || ! -d "${_artifact_dir}" ]]; then
    echo "ERROR: Built desktop artifact directory not found under ${srcdir}/out" >&2
    return 1
  fi

  local _verify_args=(--artifact "${_artifact_dir}")
  if [[ "${_keep_updater}" == "1" ]]; then
    _verify_args+=(--keep-updater)
  fi
  if [[ "${_strict_offline}" == "1" ]]; then
    _verify_args+=(--strict-offline)
  fi
  python3 "${_repo_root}/t3clean.py" verify "${_verify_args[@]}"
}

package() {
  local _payload_dir _src_dir
  _src_dir="$(_t3clean_source_dir)"
  if [[ "${_use_system_electron}" == "1" ]]; then
    _payload_dir="${srcdir}/out/linux-system-electron"
  else
    _payload_dir="$(find "${srcdir}/out" -maxdepth 1 -type d -name 'linux*-unpacked' -print -quit)"
  fi
  if [[ -z "${_payload_dir}" || ! -d "${_payload_dir}" ]]; then
    echo "ERROR: Packaged payload directory missing under ${srcdir}/out" >&2
    return 1
  fi

  install -d "${pkgdir}/usr/lib/${pkgname}"
  cp -a "${_payload_dir}/." "${pkgdir}/usr/lib/${pkgname}/"
  if [[ "${_use_system_electron}" == "1" ]]; then
    printf '%s\n' "${_system_electron_bin}" > "${pkgdir}/usr/lib/${pkgname}/.use-system-electron"
  fi
  chmod -R a+rX "${pkgdir}/usr/lib/${pkgname}"

  install -Dm755 "${srcdir}/t3-code-no-telemetry.sh" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "${srcdir}/t3-code-no-telemetry.desktop" \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"

  local _icon_src="${_src_dir}/assets/prod/black-universal-1024.png"
  if [[ -f "${_icon_src}" ]]; then
    local _resize_tool=""
    if command -v magick >/dev/null 2>&1; then
      _resize_tool="magick"
    elif command -v convert >/dev/null 2>&1; then
      _resize_tool="convert"
    fi
    local _size
    for _size in 16 22 24 32 48 64 128 256 512; do
      install -d "${pkgdir}/usr/share/icons/hicolor/${_size}x${_size}/apps"
      if [[ -n "${_resize_tool}" ]]; then
        "${_resize_tool}" "${_icon_src}" -resize "${_size}x${_size}" \
          "${pkgdir}/usr/share/icons/hicolor/${_size}x${_size}/apps/${pkgname}.png"
      elif [[ "${_size}" == "512" ]]; then
        install -Dm644 "${_icon_src}" \
          "${pkgdir}/usr/share/icons/hicolor/${_size}x${_size}/apps/${pkgname}.png"
      fi
    done
    if [[ -f "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${pkgname}.png" ]]; then
      install -Dm644 "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${pkgname}.png" \
        "${pkgdir}/usr/share/pixmaps/${pkgname}.png"
    else
      install -Dm644 "${_icon_src}" "${pkgdir}/usr/share/pixmaps/${pkgname}.png"
    fi
  fi

  install -Dm644 "${_src_dir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
